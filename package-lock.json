<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PrayerBase</title>

<style>
  /* ============================================================
     STEP 1: COLORS AND FONTS
     We keep all our colors in one place (called "variables")
     so if we want to change the look later, we only change it here!
     ============================================================ */
  :root{
    --night:      #161B33;   /* deep night-sky background */
    --card:       #202849;   /* slightly lighter card background */
    --card-line:  #333c66;   /* faint border color for cards */
    --gold:       #E8B86D;   /* warm candle-glow gold */
    --rose:       #E97C6C;   /* soft warm rose/coral accent */
    --cream:      #F5F1E8;   /* off-white text color */
    --dim:        #ABB1CC;   /* dimmer grey-blue text */
    --good:       #7FC29B;   /* soft green for "success" messages */
  }

  * { box-sizing: border-box; }

  body{
    margin: 0;
    background: var(--night);
    color: var(--cream);
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.5;
  }

  /* A gentle glowing dot pattern behind everything, like stars */
  body::before{
    content:"";
    position: fixed;
    inset: 0;
    background-image:
      radial-gradient(2px 2px at 20% 30%, rgba(232,184,109,0.35), transparent),
      radial-gradient(2px 2px at 70% 60%, rgba(232,184,109,0.25), transparent),
      radial-gradient(1.5px 1.5px at 40% 80%, rgba(232,184,109,0.3), transparent),
      radial-gradient(1.5px 1.5px at 85% 20%, rgba(232,184,109,0.2), transparent);
    pointer-events: none;
    z-index: 0;
  }

  h1, h2, h3 { font-family: Georgia, serif; margin: 0 0 8px; }

  button{
    font-family: inherit;
    cursor: pointer;
    border: none;
    border-radius: 10px;
  }

  input, select{
    font-family: inherit;
    font-size: 1rem;
    border-radius: 8px;
    border: 1px solid var(--card-line);
    background: var(--night);
    color: var(--cream);
    padding: 10px 12px;
  }

  .hidden{ display: none !important; }

  /* ============================================================
     STEP 2: LAYOUT PIECES
     ============================================================ */

  /* The very top hero section with the app name */
  .hero{
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 56px 20px 34px;
  }
  .flame{
    font-size: 2.6rem;
    display: inline-block;
    animation: flicker 2.4s ease-in-out infinite;
  }
  @keyframes flicker{
    0%, 100% { transform: translateY(0) scale(1); opacity: 1; }
    50%      { transform: translateY(-3px) scale(1.06); opacity: 0.85; }
  }
  .hero h1{
    font-size: clamp(2rem, 6vw, 3rem);
    color: var(--gold);
    letter-spacing: 0.5px;
  }
  .hero p{ color: var(--dim); max-width: 420px; margin: 8px auto 0; }

  /* Sticky top navigation pills (only shows once logged in) */
  nav.tabs{
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 12px 16px;
    background: rgba(22,27,51,0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--card-line);
  }
  nav.tabs button{
    flex: none;
    padding: 8px 16px;
    background: var(--card);
    color: var(--dim);
    font-size: 0.9rem;
    border: 1px solid var(--card-line);
  }
  nav.tabs button.active{
    background: var(--gold);
    color: var(--night);
    font-weight: bold;
    border-color: var(--gold);
  }

  main{
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
    padding: 24px 16px 80px;
  }

  section.panel{ margin-bottom: 40px; }

  .card{
    background: var(--card);
    border: 1px solid var(--card-line);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 14px;
  }

  .btn-primary{
    background: var(--gold);
    color: var(--night);
    font-weight: bold;
    padding: 12px 20px;
    width: 100%;
    font-size: 1rem;
  }
  .btn-primary:hover{ filter: brightness(1.08); }

  .btn-secondary{
    background: transparent;
    color: var(--gold);
    border: 1px solid var(--gold);
    padding: 10px 16px;
  }

  /* --- Login card --- */
  #loginScreen{ max-width: 380px; margin: 0 auto; }
  #loginScreen label{
    display:block; font-size: 0.85rem; color: var(--dim); margin: 12px 0 4px;
  }
  #loginScreen input{ width: 100%; }
  #loginMsg{ margin-top: 10px; font-size: 0.9rem; color: var(--rose); min-height: 1.2em; }

  /* --- Prayer type menu grid --- */
  .type-grid{
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .type-btn{
    background: var(--night);
    border: 1px solid var(--card-line);
    color: var(--cream);
    padding: 14px 10px;
    border-radius: 12px;
    text-align: left;
  }
  .type-btn .emoji{ font-size: 1.4rem; display:block; margin-bottom: 6px; }
  .type-btn.selected{ border-color: var(--gold); background: rgba(232,184,109,0.12); }

  .scripture{
    border-left: 3px solid var(--gold);
    padding-left: 12px;
    margin-top: 14px;
    font-style: italic;
    color: var(--cream);
  }
  .scripture cite{
    display:block;
    font-style: normal;
    color: var(--dim);
    margin-top: 4px;
    font-size: 0.85rem;
  }

  /* --- Prayer circle (people connecting) --- */
  .person-row{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--card-line);
  }
  .person-row:last-child{ border-bottom: none; }
  .person-info{ display:flex; align-items:center; gap: 10px; }
  .avatar{
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--rose);
    display:flex; align-items:center; justify-content:center;
    font-weight: bold; color: var(--night);
  }
  .status-dot{
    width:8px; height:8px; border-radius:50%; background: var(--good);
    display:inline-block; margin-right:6px;
  }
  .join-btn{
    background: var(--card-line); color: var(--cream);
    padding: 6px 12px; font-size: 0.85rem;
  }
  .join-btn.joined{ background: var(--good); color: var(--night); font-weight:bold; }

  /* --- Hymn player --- */
  .player{
    display:flex; align-items:center; gap: 14px;
  }
  .play-btn{
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--gold); color: var(--night);
    font-size: 1.3rem; flex: none;
  }
  .wave{ display:flex; gap:3px; align-items:flex-end; height: 30px; flex:1; }
  .wave span{
    width:4px; background: var(--gold); border-radius: 2px;
    height: 6px; opacity: 0.5;
  }
  .wave.playing span{ animation: bounce 0.9s ease-in-out infinite; }
  .wave span:nth-child(2){ animation-delay: 0.1s; }
  .wave span:nth-child(3){ animation-delay: 0.2s; }
  .wave span:nth-child(4){ animation-delay: 0.3s; }
  .wave span:nth-child(5){ animation-delay: 0.4s; }
  @keyframes bounce{
    0%, 100% { height: 6px; opacity:0.5; }
    50%      { height: 26px; opacity:1; }
  }

  footer{
    text-align:center; color: var(--dim); font-size: 0.8rem;
    padding: 20px; position: relative; z-index: 1;
  }

  /* Make sure it looks good on small phones too! */
  @media (max-width: 380px){
    .type-grid{ grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

  <!-- ================================================================
       HERO: the welcome banner everyone sees first
       ================================================================ -->
  <div class="hero">
    <span class="flame">🕯️</span>
    <h1>PrayerBase</h1>
    <p>Your home base for prayer, scripture and community.</p>
  </div>

  <!-- ================================================================
       LOGIN SCREEN: shown until the person "logs in"
       (This is just a mockup, so any name + password works!)
       ================================================================ -->
  <main>
    <div id="loginScreen" class="card">
      <h2>Welcome back</h2>
      <p style="color:var(--dim); font-size:0.9rem;">Only registered members can enter PrayerBase.</p>

      <label for="usernameInput">Your name</label>
      <input id="usernameInput" type="text" placeholder="e.g. Sam" />

      <label for="passwordInput">Password</label>
      <input id="passwordInput" type="password" placeholder="••••••••" />

      <button class="btn-primary" style="margin-top:18px;" onclick="handleLogin()">Log In</button>
      <p id="loginMsg"></p>
    </div>

    <!-- ================================================================
         THE MAIN APP: hidden until login succeeds
         ================================================================ -->
    <div id="appScreen" class="hidden">

      <!-- Little tab bar to jump between the 4 features -->
      <nav class="tabs">
        <button class="tab-btn active" data-tab="times">⏰ Prayer Times</button>
        <button class="tab-btn" data-tab="types">📖 Prayer Types</button>
        <button class="tab-btn" data-tab="circle">🤝 Prayer Circle</button>
        <button class="tab-btn" data-tab="hymn">🎵 Hymn</button>
      </nav>

      <p style="text-align:center; color:var(--dim); margin-top:16px;">
        Welcome, <span id="welcomeName" style="color:var(--gold); font-weight:bold;"></span> 👋
      </p>

      <!-- ---------- PANEL 1: Prayer Time Notifications ---------- -->
      <section class="panel" id="panel-times">
        <div class="card">
          <h3>Set your prayer time</h3>
          <p style="color:var(--dim); font-size:0.9rem;">
            Pick a time and PrayerBase will remind everyone who has the app installed.
          </p>
          <label for="timeInput" style="display:block; margin:12px 0 6px; font-size:0.85rem; color:var(--dim);">Reminder time</label>
          <input id="timeInput" type="time" value="18:00" />
          <button class="btn-primary" style="margin-top:14px;" onclick="setPrayerReminder()">Save Reminder</button>
          <p id="reminderMsg" style="margin-top:10px; color: var(--good); font-size:0.9rem;"></p>
        </div>
      </section>

      <!-- ---------- PANEL 2: Prayer Types + Scriptures ---------- -->
      <section class="panel hidden" id="panel-types">
        <div class="card">
          <h3>Choose a prayer type</h3>
          <div class="type-grid" id="typeGrid"><!-- filled in by JavaScript below --></div>
          <div id="scriptureBox" class="scripture hidden"></div>
        </div>
      </section>

      <!-- ---------- PANEL 3: Prayer Circle (connect with others) ---------- -->
      <section class="panel hidden" id="panel-circle">
        <div class="card">
          <h3>People praying right now</h3>
          <div id="peopleList"><!-- filled in by JavaScript below --></div>
        </div>
      </section>

      <!-- ---------- PANEL 4: Hymn Player ---------- -->
      <section class="panel hidden" id="panel-hymn">
        <div class="card">
          <h3>Play a hymn while you pray</h3>
          <p style="color:var(--dim); font-size:0.9rem;">A gentle melody to help you focus.</p>
          <div class="player" style="margin-top:16px;">
            <button class="play-btn" id="playBtn" onclick="toggleHymn()">▶</button>
            <div class="wave" id="waveBox">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
        </div>
      </section>

    </div><!-- end #appScreen -->
  </main>

  <footer>Made for a junior developer class 💛 PrayerBase is a mockup, not a real app.</footer>

<script>
  /* ================================================================
     STEP 3: DATA
     We keep our information (prayer types + scriptures + people)
     in simple lists at the top, so it's easy to read and change.
     ================================================================ */

  // Each prayer type has a name, an emoji, a short guideline, and a Bible verse.
  const prayerTypes = [
    {
      name: "Thanksgiving",
      emoji: "🙏",
      guide: "Thank God for the good things in your life, big or small.",
      verse: "Give thanks in all circumstances; for this is God's will for you.",
      verseRef: "1 Thessalonians 5:18"
    },
    {
      name: "Petition",
      emoji: "🕊️",
      guide: "Ask for something you need, with an honest and hopeful heart.",
      verse: "Ask, and it will be given to you; seek, and you will find.",
      verseRef: "Matthew 7:7"
    },
    {
      name: "Intercession",
      emoji: "🤲",
      guide: "Pray on behalf of someone else — a friend, family member, or the world.",
      verse: "Pray for one another, that you may be healed.",
      verseRef: "James 5:16"
    },
    {
      name: "Confession",
      emoji: "💛",
      guide: "Talk honestly about mistakes, and ask for a fresh start.",
      verse: "If we confess our sins, he is faithful and just to forgive us.",
      verseRef: "1 John 1:9"
    },
    {
      name: "Praise",
      emoji: "✨",
      guide: "Focus on who God is, and celebrate that with joy.",
      verse: "I will praise you, Lord, with all my heart.",
      verseRef: "Psalm 9:1"
    },
    {
      name: "Guidance",
      emoji: "🧭",
      guide: "Ask for wisdom when you're not sure which way to go.",
      verse: "Trust in the Lord with all your heart, and lean not on your own understanding.",
      verseRef: "Proverbs 3:5"
    }
  ];

  // A pretend list of people who are online and praying right now.
  const prayerCircle = [
    { name: "Ama",   status: "Praying for family" },
    { name: "Kofi",  status: "Praying for peace" },
    { name: "Liu",   status: "Praying for exams" },
    { name: "Noah",  status: "Praying for healing" }
  ];

  /* ================================================================
     STEP 4: LOGIN
     This is a MOCKUP, so we don't really check a password —
     we just make sure the person typed *something* in both boxes.
     ================================================================ */
  function handleLogin(){
    const name = document.getElementById("usernameInput").value.trim();
    const pass = document.getElementById("passwordInput").value.trim();
    const msg = document.getElementById("loginMsg");

    if (name === "" || pass === "") {
      msg.textContent = "Please type a name and a password to continue.";
      return; // stop here, don't log in
    }

    // Success! Hide the login card and show the main app.
    document.getElementById("loginScreen").classList.add("hidden");
    document.getElementById("appScreen").classList.remove("hidden");
    document.getElementById("welcomeName").textContent = name;
  }

  /* ================================================================
     STEP 5: TAB SWITCHING
     Only one panel (Times / Types / Circle / Hymn) shows at a time.
     ================================================================ */
  const tabButtons = document.querySelectorAll(".tab-btn");
  tabButtons.forEach(function(button){
    button.addEventListener("click", function(){
      // Remove "active" from every tab button, then add it to the one clicked
      tabButtons.forEach(b => b.classList.remove("active"));
      button.classList.add("active");

      // Hide every panel, then show only the matching one
      document.querySelectorAll(".panel").forEach(p => p.classList.add("hidden"));
      const targetId = "panel-" + button.dataset.tab;
      document.getElementById(targetId).classList.remove("hidden");
    });
  });

  /* ================================================================
     STEP 6: PRAYER TIME REMINDER (feature #1)
     We ask the browser for permission to send notifications.
     Then we schedule one reminder for later today, just as a demo.
     ================================================================ */
  function setPrayerReminder(){
    const time = document.getElementById("timeInput").value; // e.g. "18:00"
    const msg = document.getElementById("reminderMsg");

    if (!time) {
      msg.style.color = "var(--rose)";
      msg.textContent = "Please choose a time first.";
      return;
    }

    // Ask the browser (and the person) for permission to show notifications.
    if ("Notification" in window) {
      Notification.requestPermission().then(function(permission){
        if (permission === "granted") {
          new Notification("PrayerBase", { body: "Reminder saved for " + time + " 🙏" });
        }
      });
    }

    msg.style.color = "var(--good)";
    msg.textContent = "✅ Saved! You'll be reminded every day at " + time + ".";
  }

  /* ================================================================
     STEP 7: PRAYER TYPES MENU (feature #3 and #4)
     We build the buttons using JavaScript instead of typing each
     one by hand in the HTML — this way, adding a new prayer type
     only means adding one line to the "prayerTypes" list above!
     ================================================================ */
  const typeGrid = document.getElementById("typeGrid");
  const scriptureBox = document.getElementById("scriptureBox");

  prayerTypes.forEach(function(type, index){
    const btn = document.createElement("button");
    btn.className = "type-btn";
    btn.innerHTML = '<span class="emoji">' + type.emoji + '</span>' + type.name;

    btn.addEventListener("click", function(){
      // Un-select every button, then select just this one
      document.querySelectorAll(".type-btn").forEach(b => b.classList.remove("selected"));
      btn.classList.add("selected");

      // Show the guideline and matching Bible verse for this type
      scriptureBox.classList.remove("hidden");
      scriptureBox.innerHTML =
        "<strong>" + type.name + ":</strong> " + type.guide +
        '<br><br>"' + type.verse + '"' +
        "<cite>— " + type.verseRef + "</cite>";
    });

    typeGrid.appendChild(btn);
  });

  /* ================================================================
     STEP 8: PRAYER CIRCLE (feature #5 — connecting with others)
     Like the prayer types, we build each row from our data list.
     ================================================================ */
  const peopleList = document.getElementById("peopleList");

  prayerCircle.forEach(function(person){
    const row = document.createElement("div");
    row.className = "person-row";

    // The first letter of their name becomes their little avatar icon
    const firstLetter = person.name.charAt(0);

    row.innerHTML =
      '<div class="person-info">' +
        '<div class="avatar">' + firstLetter + '</div>' +
        '<div>' +
          '<div><span class="status-dot"></span>' + person.name + '</div>' +
          '<div style="color:var(--dim); font-size:0.8rem;">' + person.status + '</div>' +
        '</div>' +
      '</div>';

    const joinBtn = document.createElement("button");
    joinBtn.className = "join-btn";
    joinBtn.textContent = "Join";
    joinBtn.addEventListener("click", function(){
      // Toggle between "Join" and "Joined" when clicked
      const alreadyJoined = joinBtn.classList.contains("joined");
      joinBtn.classList.toggle("joined");
      joinBtn.textContent = alreadyJoined ? "Join" : "Joined ✓";
    });

    row.appendChild(joinBtn);
    peopleList.appendChild(row);
  });

  /* ================================================================
     STEP 9: HYMN PLAYER (feature #6)
     We use the Web Audio API to play a few gentle notes.
     This avoids needing an internet music file, and it teaches
     how sound can be made directly in the browser!
     ================================================================ */
  let audioContext = null;   // will hold our "sound studio"
  let isPlaying = false;     // keeps track of play/pause state
  let hymnTimer = null;      // lets us stop the melody loop

  // A short, peaceful sequence of notes (like a tiny lullaby)
  const hymnNotes = [392.00, 440.00, 493.88, 440.00, 392.00, 349.23, 392.00]; // G4 A4 B4 A4 G4 F4 G4

  function playNote(frequency){
    // Create one soft musical tone and let it fade out naturally
    const oscillator = audioContext.createOscillator();
    const volume = audioContext.createGain();

    oscillator.type = "sine";              // a smooth, gentle sound wave
    oscillator.frequency.value = frequency;
    oscillator.connect(volume);
    volume.connect(audioContext.destination);

    volume.gain.setValueAtTime(0.2, audioContext.currentTime);
    volume.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.9);

    oscillator.start();
    oscillator.stop(audioContext.currentTime + 0.9);
  }

  function toggleHymn(){
    const playBtn = document.getElementById("playBtn");
    const waveBox = document.getElementById("waveBox");

    if (!isPlaying) {
      // Start playing: create the audio context the first time it's needed
      if (!audioContext) {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
      }
      isPlaying = true;
      playBtn.textContent = "⏸";
      waveBox.classList.add("playing");

      let noteIndex = 0;
      hymnTimer = setInterval(function(){
        playNote(hymnNotes[noteIndex]);
        noteIndex = (noteIndex + 1) % hymnNotes.length; // loop back to the start
      }, 950);

    } else {
      // Stop playing
      isPlaying = false;
      playBtn.textContent = "▶";
      waveBox.classList.remove("playing");
      clearInterval(hymnTimer);
    }
  }
</script>
</body>
</html>
